{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ashen Vow",
  "version": "0.6.0",
  "identifier": "com.ashenvow.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "windows": [
      {
        "title": "Ashen Vow",
        "width": 1280,
        "height": 760,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "backgroundColor": "#100d16",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Game",
    "shortDescription": "A top-down pixel action RPG.",
    "longDescription": "Ashen Vow \u2014 build a camp, fell the wilds for timber, mine Greyhollow Quarry, and face the Hollow Warden."
  }
}
